# Параметры Node.js-хостинга.
PORT=3000
HOST=0.0.0.0

# Необязательный токен защиты API.
# При задании клиент передаёт: Authorization: Bearer <значение>
API_ACCESS_TOKEN=

# Production Webhook URL n8n для browser-first дашборда.
# Backend передаёт в n8n детерминированные analysis и report_fixed_csv,
# затем ожидает JSON с final_report_csv и audit_md.
N8N_WEBHOOK_URL=

# Необязательная защита webhook n8n.
N8N_WEBHOOK_TOKEN=

# Максимальное ожидание синхронного ответа n8n в миллисекундах.
N8N_TIMEOUT_MS=120000
