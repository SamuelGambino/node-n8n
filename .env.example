# Параметры Node.js-хостинга.
PORT=3000
HOST=0.0.0.0

# Необязательный Bearer-токен только для прямого API POST /v1/audit.
# Browser-first форма / и async POST /v1/runs не используют этот токен.
API_ACCESS_TOKEN=

# Production Webhook URL n8n, который должен БЫСТРО подтвердить приём run.
# Долгая обработка ИИ продолжается внутри n8n и завершается callback-ом в Node.js.
N8N_WEBHOOK_URL=

# Необязательный Bearer-токен защиты входящего webhook n8n.
N8N_WEBHOOK_TOKEN=

# Общий секрет для POST callback из n8n в Node.js.
# В n8n передавайте его как HTTP-заголовок:
# Authorization: Bearer <N8N_CALLBACK_TOKEN>
N8N_CALLBACK_TOKEN=

# Публичный URL Render-сервиса БЕЗ завершающего /. Он формирует callback_url.
PUBLIC_BASE_URL=https://your-service.onrender.com

# Папка временных JSON-запусков. Локально можно оставить temp-db.
# Для надёжности на Render задайте путь внутри Persistent Disk, например:
# RUN_STORE_DIR=/var/data/audit-runs
RUN_STORE_DIR=temp-db

# Срок хранения результата в миллисекундах (по умолчанию 24 часа).
RUN_TTL_MS=86400000

# Только короткое ожидание подтверждения старта от n8n (по умолчанию 20 секунд).
# Не является временем ожидания ответов ИИ.
N8N_START_TIMEOUT_MS=20000
