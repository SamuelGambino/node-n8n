# Порт, на котором запускается HTTP API.
PORT=3000
HOST=0.0.0.0

# Необязательный токен для защиты POST /v1/audit.
# При задании n8n должен передавать заголовок: Authorization: Bearer <значение>.
API_ACCESS_TOKEN=

# Требуется только для команды npm run api:tunnel.
# Скопируйте действующий токен из панели ngrok. Этот файл не содержит секретов.
NGROK_AUTHTOKEN=
