{
  "name": "node-n8n-report-audit",
  "version": "0.1.0",
  "private": true,
  "description": "Детерминированный аудит отчёта по флайтам и подготовка данных для n8n.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "api:dev": "tsx src/api.ts",
    "api:start": "node dist/api.js",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1"
  }
}
